{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "image-replacement-contract-v1",
  "type": "object",
  "required": ["schema_version", "mode", "target"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"enum": ["isolated_insert", "mogrt_media_slot"]},
    "target": {
      "type": "object",
      "required": ["asset_id", "format", "start", "duration"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "format": {"enum": ["png", "jpg", "jpeg", "webp", "tif", "tiff"]},
        "start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "exclusiveMinimum": 0},
        "height": {"type": "integer", "exclusiveMinimum": 0},
        "alpha": {"type": "string"},
        "crop": {"type": "string"},
        "placeholder": {"type": "string"}
      }
    },
    "template": {"type": ["object", "null"]}
  }
}

