{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edit-recipe-v1",
  "type": "object",
  "required": ["schema_version", "id", "version", "inputs", "steps"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "object",
      "required": ["sequence_id", "assets"],
      "properties": {
        "sequence_id": {"type": "string", "minLength": 1},
        "assets": {"type": "object"}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "order", "track", "start", "duration"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["intro", "image", "information_template", "sfx", "caption", "outro"]},
          "order": {"type": "integer", "minimum": 0},
          "track": {"type": "object"},
          "start": {"type": "number", "minimum": 0},
          "duration": {"type": "number", "exclusiveMinimum": 0},
          "asset": {"type": ["string", "object", "null"]},
          "required_host_capability": {"type": "string"}
        }
      }
    },
    "policies": {"type": "object"},
    "provenance": {"type": "object"}
  }
}

